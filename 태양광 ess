<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>태양광 에너지 관리 시스템</title>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body {
            font-family: 'Noto Sans KR', sans-serif;
            background: #f0f2f5;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            padding: 20px;
        }
        .container {
            background: #fff;
            border-radius: 20px;
            box-shadow: 0 8px 40px rgba(0,0,0,0.08);
            max-width: 700px;
            width: 100%;
            overflow: hidden;
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 24px 30px 16px;
            border-bottom: 1px solid #f0f0f0;
        }
        .header-title {
            font-size: 17px;
            font-weight: 600;
            color: #1a1a2e;
            letter-spacing: -0.3px;
        }
        .header-stats {
            display: flex;
            gap: 20px;
            font-size: 12px;
            color: #888;
        }
        .header-stats .stat-item {
            text-align: center;
        }
        .header-stats .stat-value {
            font-size: 14px;
            font-weight: 700;
            color: #1a1a2e;
            margin-top: 2px;
        }
        .stat-value.selling { color: #2979ff; }
        .stat-value.buying { color: #f44336; }

        /* Canvas Area */
        .canvas-area {
            position: relative;
            width: 100%;
            height: 420px;
            overflow: hidden;
        }
        .canvas-area svg {
            position: absolute;
            top: 0; left: 0;
            width: 100%; height: 100%;
        }

        /* Node styling */
        .node-group { cursor: default; }
        .node-icon-bg {
            fill: #fff;
            stroke: #e0e0e0;
            stroke-width: 1.5;
            filter: drop-shadow(0 2px 6px rgba(0,0,0,0.06));
            transition: stroke 0.3s;
        }
        .node-label {
            font-family: 'Noto Sans KR', sans-serif;
            font-size: 12px;
            fill: #555;
            font-weight: 500;
        }
        .node-sublabel {
            font-family: 'Noto Sans KR', sans-serif;
            font-size: 10px;
            fill: #2979ff;
            font-weight: 600;
        }

        /* Flow paths */
        .flow-path {
            fill: none;
            stroke-width: 3;
            stroke-linecap: round;
            opacity: 0.18;
        }

        /* Animated dots */
        .flow-dot {
            transition: opacity 0.5s;
        }

        /* Controls */
        .controls {
            padding: 20px 30px 26px;
            border-top: 1px solid #f0f0f0;
            display: flex;
            gap: 30px;
        }
        .control-group {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 12px;
        }
        .control-label {
            font-size: 12px;
            color: #777;
            white-space: nowrap;
            min-width: 80px;
        }
        .slider-container {
            flex: 1;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        input[type="range"] {
            -webkit-appearance: none;
            appearance: none;
            flex: 1;
            height: 5px;
            border-radius: 3px;
            outline: none;
            transition: background 0.2s;
        }
        input[type="range"]::-webkit-slider-thumb {
            -webkit-appearance: none;
            appearance: none;
            width: 18px;
            height: 18px;
            border-radius: 50%;
            cursor: pointer;
            border: 2px solid #fff;
            box-shadow: 0 1px 4px rgba(0,0,0,0.2);
        }
        #sunlight { background: linear-gradient(to right, #e0e0e0, #ffb300); }
        #sunlight::-webkit-slider-thumb { background: #ffb300; }
        #demand { background: linear-gradient(to right, #e0e0e0, #2979ff); }
        #demand::-webkit-slider-thumb { background: #2979ff; }

        .slider-value {
            min-width: 36px;
            text-align: center;
            font-size: 14px;
            font-weight: 700;
            color: #333;
            background: #f5f5f5;
            padding: 4px 8px;
            border-radius: 6px;
        }
    </style>
</head>
<body>

<div class="container">
    <!-- Header -->
    <div class="header">
        <div class="header-title">태양광 에너지 관리 시스템</div>
        <div class="header-stats">
            <div class="stat-item">
                <div>생산량</div>
                <div class="stat-value" id="h-gen">120 kW</div>
            </div>
            <div class="stat-item">
                <div>사용량</div>
                <div class="stat-value" id="h-use">48 kW</div>
            </div>
            <div class="stat-item">
                <div>배터리</div>
                <div class="stat-value" id="h-bat">50.0%</div>
            </div>
            <div class="stat-item">
                <div>상태</div>
                <div class="stat-value" id="h-status">-</div>
            </div>
        </div>
    </div>

    <!-- Canvas -->
    <div class="canvas-area">
        <svg id="flowSvg" viewBox="0 0 700 420" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <!-- Icon symbols -->
                <!-- Solar Panel Icon -->
                <symbol id="icon-solar" viewBox="0 0 40 40">
                    <rect x="6" y="12" width="28" height="18" rx="2" fill="none" stroke="#F9A825" stroke-width="2"/>
                    <line x1="6" y1="18" x2="34" y2="18" stroke="#F9A825" stroke-width="1.5"/>
                    <line x1="6" y1="24" x2="34" y2="24" stroke="#F9A825" stroke-width="1.5"/>
                    <line x1="16" y1="12" x2="16" y2="30" stroke="#F9A825" stroke-width="1.5"/>
                    <line x1="24" y1="12" x2="24" y2="30" stroke="#F9A825" stroke-width="1.5"/>
                    <line x1="18" y1="30" x2="18" y2="36" stroke="#F9A825" stroke-width="2"/>
                    <line x1="22" y1="30" x2="22" y2="36" stroke="#F9A825" stroke-width="2"/>
                    <line x1="14" y1="36" x2="26" y2="36" stroke="#F9A825" stroke-width="2"/>
                    <!-- Sun rays -->
                    <circle cx="12" cy="6" r="1.5" fill="#FFD54F"/>
                    <circle cx="20" cy="4" r="1.5" fill="#FFD54F"/>
                    <circle cx="28" cy="6" r="1.5" fill="#FFD54F"/>
                </symbol>
                <!-- Inverter Icon -->
                <symbol id="icon-inverter" viewBox="0 0 40 40">
                    <rect x="8" y="8" width="24" height="24" rx="4" fill="none" stroke="#2979FF" stroke-width="2"/>
                    <text x="20" y="18" text-anchor="middle" font-size="7" font-weight="700" fill="#2979FF">DC</text>
                    <line x1="12" y1="22" x2="28" y2="22" stroke="#2979FF" stroke-width="1"/>
                    <text x="20" y="30" text-anchor="middle" font-size="7" font-weight="700" fill="#2979FF">AC</text>
                    <!-- Arrows -->
                    <path d="M14 20 L20 16 L26 20" fill="none" stroke="#90CAF9" stroke-width="1"/>
                </symbol>
                <!-- Home Icon -->
                <symbol id="icon-home" viewBox="0 0 40 40">
                    <path d="M20 6 L36 20 L32 20 L32 34 L8 34 L8 20 L4 20 Z" fill="none" stroke="#43A047" stroke-width="2" stroke-linejoin="round"/>
                    <rect x="16" y="22" width="8" height="12" fill="none" stroke="#43A047" stroke-width="1.5" rx="1"/>
                </symbol>
                <!-- Battery Icon -->
                <symbol id="icon-battery" viewBox="0 0 40 40">
                    <rect x="10" y="10" width="20" height="24" rx="3" fill="none" stroke="#7E57C2" stroke-width="2"/>
                    <rect x="15" y="6" width="10" height="5" rx="2" fill="none" stroke="#7E57C2" stroke-width="2"/>
                    <rect x="14" y="20" width="12" height="10" rx="1" fill="#CE93D8" opacity="0.5"/>
                    <!-- Lightning -->
                    <path d="M22 16 L18 23 L22 23 L18 30" fill="none" stroke="#7E57C2" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </symbol>
                <!-- Grid Icon -->
                <symbol id="icon-grid" viewBox="0 0 40 40">
                    <rect x="4" y="14" width="14" height="14" rx="2" fill="none" stroke="#78909C" stroke-width="2"/>
                    <rect x="22" y="14" width="14" height="14" rx="2" fill="none" stroke="#78909C" stroke-width="2"/>
                    <rect x="4" y="26" width="14" height="14" rx="2" fill="none" stroke="#78909C" stroke-width="2"/>
                    <rect x="22" y="26" width="14" height="14" rx="2" fill="none" stroke="#78909C" stroke-width="2"/>
                </symbol>
            </defs>

            <!-- Flow Paths (background) -->
            <path id="path-solar" class="flow-path" stroke="#F9A825" d="M140,130 Q250,130 350,210"/>
            <path id="path-home" class="flow-path" stroke="#43A047" d="M350,210 Q450,130 560,130"/>
            <path id="path-battery" class="flow-path" stroke="#7E57C2" d="M350,210 Q250,310 175,330"/>
            <path id="path-grid" class="flow-path" stroke="#2979FF" d="M350,210 Q450,310 540,330"/>

            <!-- Nodes -->
            <!-- Solar Panel - top left -->
            <g class="node-group" id="node-solar">
                <rect class="node-icon-bg" x="95" y="68" width="90" height="80" rx="14"/>
                <use href="#icon-solar" x="115" y="70" width="50" height="50"/>
                <text class="node-label" x="140" y="138" text-anchor="middle">태양광 패널</text>
            </g>

            <!-- Inverter - center -->
            <g class="node-group" id="node-inverter">
                <rect class="node-icon-bg" x="305" y="170" width="90" height="80" rx="14"/>
                <use href="#icon-inverter" x="325" y="172" width="50" height="50"/>
                <text class="node-label" x="350" y="240" text-anchor="middle">인버터</text>
            </g>

            <!-- Home - top right -->
            <g class="node-group" id="node-home">
                <rect class="node-icon-bg" x="515" y="68" width="90" height="80" rx="14"/>
                <use href="#icon-home" x="535" y="70" width="50" height="50"/>
                <text class="node-label" x="560" y="138" text-anchor="middle">우리집</text>
            </g>

            <!-- Battery - bottom left -->
            <g class="node-group" id="node-battery">
                <rect class="node-icon-bg" x="110" y="290" width="90" height="80" rx="14"/>
                <use href="#icon-battery" x="130" y="290" width="50" height="50"/>
                <text class="node-label" x="155" y="362" text-anchor="middle">배터리</text>
                <text class="node-sublabel" x="155" y="378" text-anchor="middle" id="bat-label">50%</text>
            </g>

            <!-- Grid - bottom right -->
            <g class="node-group" id="node-grid">
                <rect class="node-icon-bg" x="495" y="290" width="90" height="80" rx="14"/>
                <use href="#icon-grid" x="515" y="292" width="50" height="50"/>
                <text class="node-label" x="540" y="362" text-anchor="middle">전력망</text>
            </g>

            <!-- Animated dots container -->
            <g id="dots-container"></g>
        </svg>
    </div>

    <!-- Controls -->
    <div class="controls">
        <div class="control-group">
            <span class="control-label">햇빛 양 (%)</span>
            <div class="slider-container">
                <input type="range" id="sunlight" min="0" max="100" value="80">
                <div class="slider-value" id="sunVal">80</div>
            </div>
        </div>
        <div class="control-group">
            <span class="control-label">전력 사용량 (%)</span>
            <div class="slider-container">
                <input type="range" id="demand" min="0" max="100" value="40">
                <div class="slider-value" id="demVal">40</div>
            </div>
        </div>
    </div>
</div>

<script>
    // ── Config ──
    const DOT_COUNT = 10;
    const DOT_RADIUS = 4;
    const ANIM_SPEED = 0.006;

    // ── State ──
    let batteryLevel = 50.0;
    let animFrame;

    // ── Paths ──
    const pathIds = ['path-solar', 'path-home', 'path-battery', 'path-grid'];
    const pathColors = {
        'path-solar': '#F9A825',
        'path-home': '#43A047',
        'path-battery': '#7E57C2',
        'path-grid': '#2979FF'
    };

    // Each flow has an array of dot objects with offset
    const flows = {};

    function initDots() {
        const container = document.getElementById('dots-container');
        container.innerHTML = '';

        pathIds.forEach(pid => {
            const path = document.getElementById(pid);
            flows[pid] = [];
            for (let i = 0; i < DOT_COUNT; i++) {
                const circle = document.createElementNS('http://www.w3.org/2000/svg', 'circle');
                circle.setAttribute('r', DOT_RADIUS);
                circle.setAttribute('fill', pathColors[pid]);
                circle.setAttribute('opacity', '0');
                circle.classList.add('flow-dot');
                container.appendChild(circle);
                flows[pid].push({
                    el: circle,
                    offset: i / DOT_COUNT,
                    active: false,
                    reverse: false
                });
            }
        });
    }

    function animateDots() {
        pathIds.forEach(pid => {
            const path = document.getElementById(pid);
            const len = path.getTotalLength();
            const dots = flows[pid];

            dots.forEach(dot => {
                if (!dot.active) {
                    dot.el.setAttribute('opacity', '0');
                    return;
                }

                // Advance offset
                if (dot.reverse) {
                    dot.offset -= ANIM_SPEED;
                    if (dot.offset < 0) dot.offset += 1;
                } else {
                    dot.offset += ANIM_SPEED;
                    if (dot.offset > 1) dot.offset -= 1;
                }

                const pt = path.getPointAtLength(dot.offset * len);
                dot.el.setAttribute('cx', pt.x);
                dot.el.setAttribute('cy', pt.y);

                // Fade near ends
                const edgeFade = Math.min(dot.offset, 1 - dot.offset) * 6;
                const opacity = Math.min(1, edgeFade) * 0.85;
                dot.el.setAttribute('opacity', opacity);

                // Size variation
                const sizePulse = DOT_RADIUS + Math.sin(dot.offset * Math.PI * 2) * 1;
                dot.el.setAttribute('r', sizePulse);
            });
        });

        animFrame = requestAnimationFrame(animateDots);
    }

    function setFlowActive(pid, active, reverse = false) {
        flows[pid].forEach(dot => {
            dot.active = active;
            dot.reverse = reverse;
        });
        // Update path opacity
        document.getElementById(pid).style.opacity = active ? '0.25' : '0.1';
    }

    // ── UI Update ──
    function updateSystem() {
        const sun = parseInt(document.getElementById('sunlight').value);
        const dem = parseInt(document.getElementById('demand').value);

        document.getElementById('sunVal').textContent = sun;
        document.getElementById('demVal').textContent = dem;

        // Generation = sun * 1.5 for more realistic numbers
        const generated = Math.round(sun * 1.5);
        const usage = Math.round(dem * 1.2);
        const net = generated - usage;

        // Header stats
        document.getElementById('h-gen').textContent = generated + ' kW';
        document.getElementById('h-use').textContent = usage + ' kW';

        // Flows: always solar→inverter and inverter→home if values > 0
        setFlowActive('path-solar', sun > 0);
        setFlowActive('path-home', sun > 0 && dem > 0);

        const statusEl = document.getElementById('h-status');

        if (net > 0) {
            // Surplus
            if (batteryLevel < 100) {
                batteryLevel += net * 0.02;
                if (batteryLevel > 100) batteryLevel = 100;
                setFlowActive('path-battery', true, false); // inverter → battery
                setFlowActive('path-grid', false);
                statusEl.textContent = '충전 중';
                statusEl.className = 'stat-value';
                statusEl.style.color = '#7E57C2';
            } else {
                setFlowActive('path-battery', false);
                setFlowActive('path-grid', true, false); // inverter → grid (selling)
                statusEl.textContent = '송전 중 (판매)';
                statusEl.className = 'stat-value selling';
                statusEl.style.color = '';
            }
        } else if (net < 0) {
            const shortage = Math.abs(net);
            if (batteryLevel > 0) {
                batteryLevel -= shortage * 0.02;
                if (batteryLevel < 0) batteryLevel = 0;
                setFlowActive('path-battery', true, true); // battery → inverter
                setFlowActive('path-grid', false);
                statusEl.textContent = '방전 중';
                statusEl.className = 'stat-value';
                statusEl.style.color = '#7E57C2';
            } else {
                setFlowActive('path-battery', false);
                setFlowActive('path-grid', true, true); // grid → inverter (buying)
                statusEl.textContent = '수전 중 (구매)';
                statusEl.className = 'stat-value buying';
                statusEl.style.color = '';
            }
        } else {
            setFlowActive('path-battery', false);
            setFlowActive('path-grid', false);
            statusEl.textContent = '자급자족';
            statusEl.className = 'stat-value';
            statusEl.style.color = '#43A047';
        }

        // If sun is 0, disable all
        if (sun === 0 && dem === 0) {
            pathIds.forEach(p => setFlowActive(p, false));
            statusEl.textContent = '대기 중';
            statusEl.style.color = '#999';
        }

        // Battery display
        const batRound = batteryLevel.toFixed(1);
        document.getElementById('h-bat').textContent = batRound + '%';
        document.getElementById('bat-label').textContent = batRound + '%';

        // Node highlights
        const highlightNode = (id, color, active) => {
            const rect = document.querySelector(`#${id} .node-icon-bg`);
            if (active) {
                rect.style.stroke = color;
                rect.style.filter = `drop-shadow(0 0 8px ${color}40)`;
            } else {
                rect.style.stroke = '#e0e0e0';
                rect.style.filter = 'drop-shadow(0 2px 6px rgba(0,0,0,0.06))';
            }
        };

        highlightNode('node-solar', '#F9A825', sun > 0);
        highlightNode('node-inverter', '#2979FF', sun > 0 || dem > 0);
        highlightNode('node-home', '#43A047', dem > 0);
        highlightNode('node-battery', '#7E57C2', (net > 0 && batteryLevel < 100) || (net < 0 && batteryLevel > 0));
        highlightNode('node-grid', '#2979FF', (net > 0 && batteryLevel >= 100) || (net < 0 && batteryLevel <= 0));

        // Slider track update
        const sunSlider = document.getElementById('sunlight');
        const demSlider = document.getElementById('demand');
        sunSlider.style.background = `linear-gradient(to right, #e0e0e0 0%, #ffb300 ${sun}%, #e8e8e8 ${sun}%)`;
        demSlider.style.background = `linear-gradient(to right, #e0e0e0 0%, #2979ff ${dem}%, #e8e8e8 ${dem}%)`;
    }

    // ── Init ──
    initDots();
    animateDots();
    updateSystem();

    document.getElementById('sunlight').addEventListener('input', updateSystem);
    document.getElementById('demand').addEventListener('input', updateSystem);

    // Periodic battery simulation
    setInterval(updateSystem, 500);
</script>

</body>
</html>
